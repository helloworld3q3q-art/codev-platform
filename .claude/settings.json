{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [".claude/hooks/mcp_nudge.py"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
