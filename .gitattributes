# 行尾策略 —— 防跨环境 (Windows / WSL) CRLF churn。
# 背景: 2026-06-10 一次"直接拷贝文件"绕过 git 归一化, 把 CRLF 带进 WSL 工作树, 整文件被当成
# 改动 + 与 HEAD 冲突。eol=lf 是仓内权威约定, 覆盖各 clone 的 core.autocrlf, 任何平台 checkout
# 都落 LF, 提交也归一成 LF, 从根上杜绝 CRLF 漂移。

# 默认: git 自动识别文本/二进制, 文本一律 LF。
* text=auto eol=lf

# --- 源码 / 配置 / 文档: 显式 LF ---
*.py    text eol=lf
*.pyi   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.json  text eol=lf
*.jsonc text eol=lf
*.md    text eol=lf
*.less  text eol=lf
*.css   text eol=lf
*.scss  text eol=lf
*.html  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.sh    text eol=lf
*.ps1   text eol=lf
*.psm1  text eol=lf
*.sql   text eol=lf
*.txt   text eol=lf
*.csv   text eol=lf

# --- Windows 批处理: 保留 CRLF (cmd.exe 习惯, LF 行尾偶发解析异常) ---
*.bat   text eol=crlf
*.cmd   text eol=crlf

# --- 二进制 / 产物: 不做任何行尾转换 ---
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.svg   binary
*.webp  binary
*.zip   binary
*.gz    binary
*.tgz   binary
*.7z    binary
*.sqlite  binary
*.sqlite3 binary
*.db    binary
*.pyc   binary
*.pyd   binary
*.so    binary
*.dll   binary
*.whl   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.pdf   binary
*.xlsx  binary
*.parquet binary
*.npy   binary
