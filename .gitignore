# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv
venv/

# Secrets (env / API keys / PG password) — 禁入库
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Local state (per-project data 不入 codev-platform 仓, 留各业务仓本地)
data/
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Tool-stack health snapshots (runtime artifact, regenerated by ai-health -JsonOut)
platform_meta/health/

# Logs
*.log

# daemon log (machine-local)
mcp_server.log
*.log
search_recall.jsonl
# MCP 调用遥测 (统一写入 data_root/logs，不回写 import 包，也不入仓)
*_usage.jsonl

# maven build artifacts
target/
*.class

# node modules
node_modules/
dist/

# codegraph local DB (machine-local index, rebuild via `codegraph index`)
.codegraph/codegraph.db
.codegraph/codegraph.db-shm
.codegraph/codegraph.db-wal
.codegraph/codegraph.db.bak
.codegraph/*.pid

# .claude/{rules,skills} 是 rules/ + skills/ 真值源的 sync 副本, 不入库 (防双写漂移)
# 新 clone 后跑 codev-platform sync-rules / sync-skills 本地生成
.claude/rules/
.claude/skills/

# WSL venv + 本机临时分析产物 (机器本地, 不入仓)
linux-venv
aa.txt

# Codex 隔离实施 worktree（机器本地，不入库）
.worktrees/

# Local project registry: live entries must remain local and untracked.
/platform_meta/projects/*
!/platform_meta/projects/.gitkeep
