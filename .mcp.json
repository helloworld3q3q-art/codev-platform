{
  "_comment": "复用 platform 仓的 daemon launcher (.cmd) — multi-tenant daemon 按 project_id 路由到正确 collection. 三仓必须 clone 到同一父目录 (..\\platform 才能解析). 跨机 portable.",
  "mcpServers": {
    "codegraph": {
      "type": "stdio",
      "command": "codegraph",
      "args": ["serve", "--mcp"]
    },
    "platform-docs": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "..\\platform\\tools\\chroma\\platform-docs-mcp.cmd"],
      "timeout": 90000
    },
    "cross-link": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "..\\platform\\tools\\cross_link\\cross-link-mcp.cmd"],
      "timeout": 30000
    }
  }
}
