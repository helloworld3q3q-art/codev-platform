{
  "name": "cross-link-ts",
  "version": "0.1.0",
  "private": true,
  "description": "Scan frontend .tsx/.ts business files for calls into services/apis/* (M5 cross_link).",
  "scripts": {
    "build": "tsc -p tsconfig.json",
