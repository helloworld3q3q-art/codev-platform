    "scan:ts": "tsx src/scan_frontend_calls.ts"
  },
  "dependencies": {
    "ts-morph": "^22.0.0",
    "typescript": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0"
  }
}
