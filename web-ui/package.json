{
  "name": "codev-platform-admin-web",
  "version": "1.0.0",
  "private": true,
  "description": "codev-platform 管理后端控制台 (风格克隆自 stock-admin-web)",
  "scripts": {
    "analyze": "cross-env ANALYZE=1 max build",
    "api": "npx ts-node scripts/swagger-generator.ts",
    "prebuild": "ts-node scripts/createAntdCompatFile.ts && ts-node scripts/generateThemeVars.ts",
    "build": "max build",
    "clean": "rimraf node_modules dist .umi .umi-production",
    "deploy": "npm run build && npm run gh-pages",
    "predev": "rimraf ./src/.umi-production ./src/.umi ./node_modules/.cache && ts-node scripts/createAntdCompatFile.ts && ts-node scripts/generateThemeVars.ts",
    "dev": "npm run predev && npm run start:dev",
    "enums": "npx ts-node scripts/fetch-enums.ts",
    "gh-pages": "gh-pages -d dist",
    "postinstall": "max setup",
    "lint": "npm run lint:js && npm run lint:prettier",
    "lint:fix": "eslint --fix --cache --ext .js,.jsx,.ts,.tsx --format=pretty ./src",
    "lint:js": "eslint --cache --ext .js,.jsx,.ts,.tsx --format=pretty ./src",
    "lint:prettier": "prettier -c --write \"**/**.{js,jsx,tsx,ts,less,md,json}\" --end-of-line auto",
    "lint:prettierapi": "prettier -c --write \"src/services/**/*.{js,jsx,tsx,ts,less,md,json}\" --end-of-line auto",
    "lint-staged": "lint-staged",
    "openapi": "max openapi",
    "prettier": "prettier -c --write \"**/**.{js,jsx,tsx,ts,less,md,json}\"",
    "preview": "npm run build && max preview --port 8000",
    "start": "cross-env UMI_ENV=dev max dev",
    "start:dev": "cross-env REACT_APP_ENV=dev MOCK=none UMI_ENV=dev max dev",
    "start:no-mock": "cross-env MOCK=none UMI_ENV=dev max dev",
    "start:pre": "cross-env REACT_APP_ENV=pre UMI_ENV=dev max dev",
    "start:test": "cross-env REACT_APP_ENV=test MOCK=none UMI_ENV=dev max dev",
    "tsc": "tsc --noEmit"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "eslint --no-fix"
    ],
    "**/*.{js,jsx,tsx,ts,less,md,json}": [
      "prettier --write"
    ]
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 10"
  ],
  "dependencies": {
    "@ant-design/cssinjs": "^2.0.1",
    "@ant-design/icons": "^6.1.0",
    "@ant-design/plots": "^2.1.5",
    "@ant-design/pro-components": "^3.1.11-0",
    "@ant-design/x": "^2.7.0",
    "@ant-design/x-markdown": "^2.7.0",
    "@antv/g6": "^5.1.1",
    "@jlogi/ui": "2.0.0-alpha.2.1",
    "@types/crypto-js": "^4.2.2",
    "@types/less": "^3.0.8",
    "@umijs/route-utils": "^2.2.2",
    "antd": "^6.3.1",
    "antd-style": "^3.6.1",
    "axios": "^1.9.0",
    "classnames": "^2.5.1",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.10",
    "echarts": "^5.5.0",
    "echarts-for-react": "^3.0.2",
    "jsencrypt": "^3.3.2",
    "lodash": "^4.17.21",
    "numeral": "^2.0.6",
    "omit.js": "^2.0.2",
    "querystring": "^0.2.1",
    "rc-util": "^5.38.1",
    "react": "^18.2.0",
    "react-activation": "^0.13.4",
    "react-dom": "^18.2.0",
    "react-fittext": "^1.0.0",
    "react-force-graph-3d": "^1.29.1",
    "react-resizable": "^3.0.5",
    "three": "^0.184.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@ant-design/pro-cli": "^2.1.5",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@commitlint/types": "^19.8.1",
    "@testing-library/react": "^13.4.0",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/classnames": "^2.3.1",
    "@types/express": "^4.17.21",
    "@types/history": "^4.7.11",
    "@types/jest": "^29.5.11",
    "@types/lodash": "^4.14.202",
    "@types/lodash.debounce": "^4.0.9",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "@types/react-helmet": "^6.1.11",
    "@umijs/fabric": "^2.14.1",
    "@umijs/lint": "^4.1.0",
    "@umijs/max": "^4.6.37",
    "@unocss/preset-rem-to-px": "^66.5.5",
    "@unocss/webpack": "^66.5.5",
    "cross-env": "^7.0.3",
    "eslint": "^8.56.0",
    "eslint-plugin-filenames": "^1.3.2",
    "eslint-plugin-local-rules": "^3.0.2",
    "eslint-plugin-react": "^7.37.5",
    "express": "^4.18.2",
    "gh-pages": "^3.2.3",
    "husky": "^7.0.4",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "less": "^4.3.0",
    "less-vars-to-js": "^1.3.0",
    "lint-staged": "^16.1.0",
    "prettier": "^3.1.1",
    "prettier-plugin-organize-imports": "^3.2.4",
    "prettier-plugin-packagejson": "^2.4.8",
    "prettier-plugin-two-style-order": "^1.0.1",
    "react-dev-inspector": "^1.9.0",
    "rimraf": "^5.0.5",
    "swagger-ui-dist": "^4.19.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0",
    "umi-presets-pro": "^2.0.3",
    "unocss": "^66.5.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
